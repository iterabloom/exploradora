# Exploradora Local Development Secrets
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control (.gitignore covers it).

# GitHub credentials (required for scripts/auto-pr, merge-pr, ci-debug,
# contribute, list-my-prs). Use a fine-grained PAT scoped to
# iterabloom/exploradora only (least privilege).
# Generate at: https://github.com/settings/personal-access-tokens
EXPL_GITHUB_TOKEN=

# Woodpecker CI (required for ci-debug log fetch; CI *status* polling goes
# through the GitHub commit-status API and needs only the token above).
# The Woodpecker instance sits behind Cloudflare Access, so log fetch needs
# both the Woodpecker API token and a CF Access service-token pair.
WOODPECKER_SERVER=
WOODPECKER_TOKEN=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional: Enable debug logging for scripts
# DEBUG=1

# ============================================================
# Deliberately absent
# ============================================================
# PyPI / TestPyPI tokens are NEVER stored here (AGENTS.md §Security
# Boundaries). They are human-held and supplied only at upload time;
# the agent prepares release artifacts and stops.

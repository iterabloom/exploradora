#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Pre-commit hook: Run linting, security, and license-header checks before committing
#
# This hook runs:
# - Protected-branch block: no direct commits to dev/main
# - SPDX auto-fix: license headers repaired on staged source files
# - Ruff: Python linting (pycodestyle, pyflakes, security rules)
# - Bandit: Security-focused static analysis
# - yamllint: YAML syntax validation
#
# Adapted from hypergumbo's pre-commit hook; the hypergumbo-specific gates
# (bakeoff freeze, tracker validation, schema/axis freshness) are not ported
# because their subjects don't exist in this repository.
#
# To bypass this hook (not recommended): git commit --no-verify

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

# Block direct commits to protected branches (dev, main)
current_branch=$(git branch --show-current 2>/dev/null || true)
if [[ "$current_branch" == "dev" || "$current_branch" == "main" ]]; then
    echo ""
    echo -e "${RED}========================================================${NC}"
    echo -e "${RED}  BLOCKED: Direct commit to protected branch '$current_branch'${NC}"
    echo -e "${RED}========================================================${NC}"
    echo ""
    echo -e "${YELLOW}  Create a feature branch first:${NC}"
    echo ""
    echo "    git stash"
    echo "    git checkout -b <author>/feat/<description>"
    echo "    git stash pop"
    echo ""
    echo "  To bypass (not recommended): git commit --no-verify"
    echo ""
    exit 1
fi

# Auto-fix SPDX license headers on staged source files
_staged_src=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(py|yaml|yml|sh|md)$' || true)
# Also check extensionless files in scripts/ and .githooks/ (shell scripts)
_staged_scripts=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(scripts/|\.githooks/)' | grep -v '\.' || true)
_staged_all=$(printf '%s\n%s' "$_staged_src" "$_staged_scripts" | sort -u | grep -v '^$' || true)
if [[ -n "$_staged_all" ]]; then
    # shellcheck disable=SC2086
    _out=$(./scripts/license-headers --fix --summary --files $_staged_all 2>/dev/null || true)
    _fixed=$(echo "$_out" | grep "Fixed:" | awk '{print $2}')
    if [[ -n "$_fixed" && "$_fixed" != "0" ]]; then
        echo "$_staged_all" | xargs git add
        echo -e "  ${GREEN}Auto-fixed SPDX headers on ${_fixed} file(s)${NC}"
    fi
fi

echo "🔍 Running pre-commit checks..."

# Require ruff
if ! command -v ruff &> /dev/null; then
    echo -e "${RED}✗ ruff not installed${NC}"
    echo "  Install with: pip install ruff  (or run ./scripts/dev-install)"
    exit 1
fi

# Require bandit
if ! command -v bandit &> /dev/null; then
    echo -e "${RED}✗ bandit not installed${NC}"
    echo "  Install with: pip install bandit  (or run ./scripts/dev-install)"
    exit 1
fi

# Run ruff on whatever source/test dirs exist
echo -n "  Ruff (linting)... "
RUFF_PATHS=""
[ -d "src" ] && RUFF_PATHS="src/"
[ -d "tests" ] && RUFF_PATHS="$RUFF_PATHS tests/"
if [ -z "$RUFF_PATHS" ]; then
    echo -e "${YELLOW}skipped (no src/ or tests/)${NC}"
# shellcheck disable=SC2086
elif ruff check --no-cache $RUFF_PATHS --quiet 2>/dev/null; then
    echo -e "${GREEN}✓${NC}"
else
    echo -e "${RED}✗${NC}"
    echo ""
    echo -e "${RED}Ruff found issues:${NC}"
    # shellcheck disable=SC2086
    ruff check --no-cache $RUFF_PATHS
    exit 1
fi

# Run bandit (uses pyproject.toml config when present)
echo -n "  Bandit (security)... "
BANDIT_CONF=""
[ -f "pyproject.toml" ] && BANDIT_CONF="-c pyproject.toml"
if [ ! -d "src" ]; then
    echo -e "${YELLOW}skipped (no src/)${NC}"
# shellcheck disable=SC2086
elif bandit -r src/ $BANDIT_CONF --quiet 2>/dev/null; then
    echo -e "${GREEN}✓${NC}"
else
    echo -e "${RED}✗${NC}"
    echo ""
    echo -e "${RED}Bandit found security issues:${NC}"
    # shellcheck disable=SC2086
    bandit -r src/ $BANDIT_CONF
    exit 1
fi

# Run yamllint (optional - skip if not installed)
echo -n "  yamllint (YAML syntax)... "
if command -v yamllint &> /dev/null; then
    YAML_TARGETS=""
    [ -d ".woodpecker" ] && YAML_TARGETS=".woodpecker/"
    if [ -z "$YAML_TARGETS" ]; then
        echo -e "${YELLOW}skipped (no YAML dirs)${NC}"
    # shellcheck disable=SC2086
    elif yamllint -c .yamllint.yaml $YAML_TARGETS 2>/dev/null; then
        echo -e "${GREEN}✓${NC}"
    else
        echo -e "${RED}✗${NC}"
        echo ""
        echo -e "${RED}yamllint found issues:${NC}"
        # shellcheck disable=SC2086
        yamllint -c .yamllint.yaml $YAML_TARGETS
        exit 1
    fi
else
    echo -e "${YELLOW}skipped (not installed)${NC}"
fi

echo -e "${GREEN}✅ Pre-commit checks passed${NC}"
